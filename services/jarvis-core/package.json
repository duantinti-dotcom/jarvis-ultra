{
  "name": "@jarvis/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "JARVIS Core — cérebro local: modelos, planejamento, ferramentas, memória, laboratório e relay",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:llm": "JARVIS_LLM_TESTS=1 vitest run test/llm",
    "bench": "tsx src/bench/cli.ts",
    "cli": "tsx scripts/cli.ts"
  },
  "dependencies": {
    "@jarvis/contracts": "workspace:*",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "mammoth": "^1.13.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "unpdf": "^2.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pngjs": "^6.0.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
