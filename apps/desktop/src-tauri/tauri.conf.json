{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JARVIS ULTRA",
  "version": "0.1.0",
  "identifier": "com.jarvisultra.desktop",
  "build": { "frontendDist": "../splash" },
  "app": {
    "windows": [
      { "label": "main", "title": "JARVIS ULTRA", "width": 560, "height": 420, "resizable": false, "center": true, "decorations": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "JARVIS ULTRA",
    "copyright": "JARVIS ULTRA",
    "category": "Productivity",
    "shortDescription": "Assistente pessoal de IA local",
    "longDescription": "JARVIS ULTRA: assistente de IA que roda no seu computador com modelos locais (Ollama), memória persistente, voz e controle autorizado do Windows.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/node"],
    "resources": { "resources/core/": "core/", "resources/ui/": "ui/" },
    "windows": {
      "nsis": { "installMode": "currentUser", "languages": ["PortugueseBR"], "displayLanguageSelector": false, "installerIcon": "icons/icon.ico" },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
